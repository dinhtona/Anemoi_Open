(anemoi_routes) {
	@mail path /mail /mail/*
	reverse_proxy @mail smtp4dev:80

	@hr path /api/hr /api/hr/*
	reverse_proxy @hr anemoi_hr:8080

	@backend path /api /api/* /hubs /hubs/*
	reverse_proxy @backend anemoi_centralize:8080
	# TODO(CRIT-2): re-enable with the anemoi_web service once the frontend
	# code exists in this repo.
	# reverse_proxy anemoi_web:3000
}

# Local browser entrypoint. Caddy creates and renews a local CA certificate.
localhost {
	import anemoi_routes
}

# HTTP entrypoint. HTTPS terminates at the Cloudflare edge for the optional
# "public" profile, so plain HTTP on port 80 must keep serving the tunnel
# (a blanket http->https redirect here would loop back through the tunnel).
# Only direct local browser hits on http://localhost are redirected to HTTPS.
http:// {
	@local_http host localhost
	handle @local_http {
		redir https://{host}{uri} permanent
	}
	handle {
		import anemoi_routes
	}
}
