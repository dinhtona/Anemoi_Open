# ==============================================================================
# Anemoi_Open — Environment Variables Template
# USAGE: Copy this file to .env and fill in real values before running Docker.
#        NEVER commit .env to version control.
# ==============================================================================

# Bind published Docker ports to localhost by default. Set 0.0.0.0 only when
# devices on the local network must connect directly to development services.
BIND_ADDRESS=127.0.0.1

# Host port for Redis. Change this if another local Redis already uses 6379.
# Services in this compose stack still connect internally to redis:6379.
REDIS_HOST_PORT=6379

# Host ports for smtp4dev. Change SMTP_HOST_PORT if another local SMTP server
# already uses port 25. The web UI is available on SMTP_WEB_HOST_PORT.
SMTP_HOST_PORT=25
SMTP_WEB_HOST_PORT=5555

# Host port for the local SFTP development server.
SFTP_HOST_PORT=2222

# SFTP dev-server credentials. Only used if you uncomment the `sftp` service
# in docker-compose.yml (it is disabled by default).
SFTP_USER=user1
SFTP_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Runtime environment for the six .NET services. Defaults to Development when
# unset (compose uses ${ASPNETCORE_ENVIRONMENT:-Development}).
# For a production-like run use: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# ASPNETCORE_ENVIRONMENT=Development

# Host port for the HR API service.
HR_API_HOST_PORT=8082

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Microsoft SQL Server ───────────────────────────────────────────────────
# Must satisfy SQL Server password complexity: upper/lowercase, number, symbol.
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE_123!

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
# Do NOT use 'guest' in production — it is restricted to localhost by default
RABBITMQ_DEFAULT_USER=anemoi_user
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Development seed users ──────────────────────────────────────────────────
# Password for the dev/test users seeded by the Identity WorkerService in
# Development (SeedUserData:DevTestUsers in appsettings.Development.json).
# The service fails fast at startup if this is not set.
DEV_TEST_USER_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ISSUER=anemoi-identity
JWT_AUDIENCE=anemoi-services
JWT_PRIVATE_KEY_PATH=/home/app/.anemoi/jwt/development-private.key
JWT_PUBLIC_KEY_PATH=/home/app/.anemoi/jwt/development-public.crt

# ── OAuth ─────────────────────────────────────────────────────────────────────
# Leave empty if social login is not needed in the local environment.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# ── Optional Cloudflare Tunnel ────────────────────────────────────────────────
# Used only with: docker compose --profile public up -d
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_APP_ORIGIN=

# ── S3 / Object Storage ───────────────────────────────────────────────────────
S3_SERVICE_URL=http://your-s3-compatible-endpoint
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_NAME=anemoi-bucket
