diff --git a/Anemoi.BuildingBlocks/Anemoi.BuildingBlock.Application/Authorization/PermissionMetadataLocalizer.cs b/Anemoi.BuildingBlocks/Anemoi.BuildingBlock.Application/Authorization/PermissionMetadataLocalizer.cs
new file mode 100644
index 0000000..0b9bd93
--- /dev/null
+++ b/Anemoi.BuildingBlocks/Anemoi.BuildingBlock.Application/Authorization/PermissionMetadataLocalizer.cs
@@ -0,0 +1,59 @@
+using System.Globalization;
+using System.Resources;
+using Anemoi.BuildingBlock.Application.Resources;
+
+namespace Anemoi.BuildingBlock.Application.Authorization;
+
+/// <summary>
+/// Localized display metadata for a role/permission.
+/// </summary>
+public sealed record PermissionRoleMetadata(string Group, string Description, bool HasMissingKey);
+
+/// <summary>
+/// Resolves permission group/description display metadata from <see cref="SharedResource"/>
+/// resource files. Per AGENTS.md permission translation rule: this localizer NEVER
+/// fabricates a display name from the permission code (no ToDisplayName-style
+/// sanitizer/fallback). A missing resource key is surfaced as the raw key itself
+/// (with <see cref="PermissionRoleMetadata.HasMissingKey"/> set) so gaps are visible
+/// and fail localization tests instead of being silently hidden.
+/// </summary>
+public sealed class PermissionMetadataLocalizer
+{
+    public const string OtherGroupKey = "PermissionGroupOther";
+    public const string UnmappedDescriptionKey = "PermissionDescriptionUnmapped";
+
+    private static readonly ResourceManager Resources =
+        new(typeof(SharedResource).FullName!, typeof(SharedResource).Assembly);
+
+    public PermissionRoleMetadata Localize(string roleName, CultureInfo culture)
+    {
+        var permission = Permissions.Find(roleName);
+
+        var group = ResolveKey(permission?.GroupKey ?? OtherGroupKey, culture, out var groupMissing);
+
+        string description;
+        bool descriptionMissing;
+        if (permission is null)
+        {
+            var template = ResolveKey(UnmappedDescriptionKey, culture, out descriptionMissing);
+            description = string.Format(culture, template, roleName);
+        }
+        else
+        {
+            description = ResolveKey(permission.DescriptionKey, culture, out descriptionMissing);
+        }
+
+        return new PermissionRoleMetadata(group, description, groupMissing || descriptionMissing);
+    }
+
+    /// <summary>
+    /// Resolves a single resource key. Returns the raw key itself when the resource
+    /// is missing — never a fabricated display name.
+    /// </summary>
+    public string ResolveKey(string key, CultureInfo culture, out bool isMissing)
+    {
+        var value = Resources.GetString(key, culture);
+        isMissing = string.IsNullOrWhiteSpace(value);
+        return isMissing ? key : value!;
+    }
+}
diff --git a/Anemoi.BuildingBlocks/Anemoi.BuildingBlock.Application/Helpers/ConfigurationPlaceholders.cs b/Anemoi.BuildingBlocks/Anemoi.BuildingBlock.Application/Helpers/ConfigurationPlaceholders.cs
new file mode 100644
index 0000000..d7b823a
--- /dev/null
+++ b/Anemoi.BuildingBlocks/Anemoi.BuildingBlock.Application/Helpers/ConfigurationPlaceholders.cs
@@ -0,0 +1,46 @@
+using System;
+using System.Text.RegularExpressions;
+
+namespace Anemoi.BuildingBlock.Application.Helpers;
+
+/// <summary>
+/// Resolves <c>${ENV_VAR}</c> placeholders in configuration values from environment variables.
+/// SEC-006: secrets must never be hard-coded in appsettings files — config files carry the
+/// placeholder and the real value comes from the environment (or <c>.env</c> via docker compose).
+/// </summary>
+public static class ConfigurationPlaceholders
+{
+    /// <summary>
+    /// Stable error code surfaced when a required configuration value (or its environment
+    /// variable) is missing. Also registered in <c>SharedResource.*.resx</c> for localization.
+    /// </summary>
+    public const string MissingConfigurationErrorCode = "MissingRequiredConfiguration";
+
+    private static readonly Regex PlaceholderPattern =
+        new(@"\$\{([A-Za-z_][A-Za-z0-9_]*)\}", RegexOptions.Compiled);
+
+    /// <summary>
+    /// Expands every <c>${ENV_VAR}</c> in <paramref name="configuredValue"/> from the environment.
+    /// Throws <see cref="InvalidOperationException"/> carrying the stable error code when the
+    /// value itself or any referenced environment variable is missing/empty, so misconfiguration
+    /// fails fast and loudly at startup instead of silently running with a broken credential.
+    /// </summary>
+    public static string ResolveRequired(string? configuredValue, string configPath)
+    {
+        if (string.IsNullOrWhiteSpace(configuredValue))
+            throw new InvalidOperationException(
+                $"[{MissingConfigurationErrorCode}] '{configPath}' is not configured. " +
+                "Provide the value or a ${ENV_VAR} placeholder.");
+
+        return PlaceholderPattern.Replace(configuredValue, match =>
+        {
+            var envName = match.Groups[1].Value;
+            var envValue = Environment.GetEnvironmentVariable(envName);
+            if (string.IsNullOrEmpty(envValue))
+                throw new InvalidOperationException(
+                    $"[{MissingConfigurationErrorCode}] '{configPath}' references environment variable " +
+                    $"'{envName}' which is not set or empty. Set it before starting the service.");
+            return envValue;
+        });
+    }
+}
