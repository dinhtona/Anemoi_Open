# ==============================================================================
# Anemoi_Open — Production Environment Variables
# USAGE: cp .env.production.example .env.production
#        Fill in real values, then deploy with scripts/deploy.sh
#        NEVER commit .env.production to version control.
# ==============================================================================

# ── Container Registry ──────────────────────────────────────────────────────
GHCR_PREFIX=ghcr.io/dinhtona
IMAGE_TAG=latest

# ── DNS / Domain ────────────────────────────────────────────────────────────
APP_DOMAIN=hr.example.com
PUBLIC_APP_ORIGIN=https://hr.example.com

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=anemoi
POSTGRES_PASSWORD=CHANGE_ME

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=anemoi_user
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# ── Redis (mandatory password in production) ────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_ISSUER=anemoi-identity
JWT_AUDIENCE=anemoi-services
JWT_PRIVATE_KEY_PATH=/home/app/.anemoi/jwt/production-private.key
JWT_PUBLIC_KEY_PATH=/home/app/.anemoi/jwt/production-public.key

# ── OAuth ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# ── S3 / Object Storage ─────────────────────────────────────────────────────
S3_SERVICE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=anemoi-prod

# ── Host Paths ──────────────────────────────────────────────────────────────
JWT_KEYS_HOST_PATH=/opt/anemoi/jwt
UPLOADS_HOST_PATH=/opt/anemoi/uploads
CADDYFILE_HOST_PATH=./deploy/Caddyfile
